{
  "name": "palatinus-tactics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An Ogre Battle 64-style real-time strategy RPG built with Phaser 3 and TypeScript",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract:ob64": "tsx tools/extract-ob64.ts",
    "scrape:expansion": "tsx tools/scrape-expansion.ts",
    "e2e": "node e2e/playthrough.mjs",
    "pack:models": "tsx tools/pack-models.ts"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@types/three": "^0.185.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
